# Copy to .env:  cp .env.example .env   (then edit)
BOT_NAME=HAWEE-XD
# Numbers with country code, no + or spaces
PHONE_NUMBER=254700000000
OWNER_NUMBER=254700000000
# Command prefix: . or ! or leave blank for none (do NOT name it PREFIX - Termux uses that)
BOT_PREFIX=.
# public = everyone can use commands, private = owner only
MODE=public
TIMEZONE=Africa/Nairobi

AUTO_VIEW_STATUS=false
AUTO_STATUS_REACT=false
AUTO_REACT=false
AUTO_READ_MESSAGES=false
AUTO_TYPING=false
ANTIDELETE=false
WELCOME=false
CHATBOT=false

# --- Pairing page (node pair.js) ---
PAIR_PASSWORD=change-me-please
# PORT=3000
# HOST=127.0.0.1   (use 0.0.0.0 on a cloud host)
# --- Hosting: paste the SESSION_ID the pairing page gives you ---
# SESSION_ID=

# --- Extras (all optional) ---
ANTILINK=off              # off | on | kick
ANTICALL=false
ANTISTATUS=false
STATUS_DOWNLOAD=false
POWERED_BY=HawardTech
# ANTHROPIC_API_KEY=      # makes the .ai chatbot use Claude instead of keyword replies
# AI_MODEL=claude-haiku-4-5-20251001
# TENOR_KEY=              # free Tenor API key, for .emojimix
# MAX_DOWNLOAD_MB=50
# YTDLP_COOKIES=/path/to/cookies.txt   # helps with Instagram/YouTube login walls
# YTDLP_EXTRA=            # extra yt-dlp flags if YouTube changes its requirements
